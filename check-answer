#!/usr/bin/env bash

# Simple checker for bootdotdev golang exercises
# Usage: check-answer --module 3 --lesson 4

set -euo pipefail

usage() {
  cat <<EOF
Usage: $(basename "$0") --module <n> --lesson <n>

Runs the user's code.go and the solution complete.go for the specified module and lesson
and compares their outputs.

Examples:
  $(basename "$0") --module 3 --lesson 4
EOF
}

MODULE=""
LESSON=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --module)
      MODULE="$2"; shift 2 ;;
    --lesson)
      LESSON="$2"; shift 2 ;;
    -h|--help)
      usage; exit 0 ;;
    *)
      echo "Unknown arg: $1" >&2; usage; exit 2;;
  esac
done

if [[ -z "$MODULE" || -z "$LESSON" ]]; then
  echo "Both --module and --lesson are required" >&2
  usage
  exit 2
fi

ROOT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Find the module directory under course that starts with the module number and a hyphen
MODULE_DIR=""
for d in "$ROOT_DIR"/course/${MODULE}-*; do
  if [[ -d "$d" ]]; then
    MODULE_DIR="$d"
    break
  fi
done

if [[ -z "$MODULE_DIR" ]]; then
  echo "Module directory for module $MODULE not found under $ROOT_DIR/course" >&2
  exit 3
fi

# Search in exercises and challenges
EXER_DIR=""
for parent in exercises challenges; do
  candidate="$MODULE_DIR/$parent/$LESSON-"
  # find folder that starts with LESSON-
  for d in "$MODULE_DIR/$parent/$LESSON-"*; do
    if [[ -d "$d" ]]; then
      EXER_DIR="$d"
      break 2
    fi
  done
done

if [[ -z "$EXER_DIR" ]]; then
  echo "Exercise directory for lesson $LESSON not found under $MODULE_DIR" >&2
  exit 4
fi

echo "Found exercise: $EXER_DIR"

STUDENT="$EXER_DIR/code.go"
SOLUTION="$EXER_DIR/complete.go"

if [[ ! -f "$STUDENT" ]]; then
  echo "Student file not found: $STUDENT" >&2
  exit 5
fi
if [[ ! -f "$SOLUTION" ]]; then
  echo "Solution file not found: $SOLUTION" >&2
  exit 6
fi

TMPDIR=$(mktemp -d)
student_out="$TMPDIR/student.out"
student_err="$TMPDIR/student.err"
solution_out="$TMPDIR/solution.out"
solution_err="$TMPDIR/solution.err"

echo "Running student code..."
if ! go run "$STUDENT" >"$student_out" 2>"$student_err"; then
  echo "Student program exited with non-zero status. Stderr:" >&2
  sed -n '1,200p' "$student_err" >&2
  echo "--- Full stdout ---"
  sed -n '1,200p' "$student_out"
fi

echo "Running solution code..."
if ! go run "$SOLUTION" >"$solution_out" 2>"$solution_err"; then
  echo "Solution program exited with non-zero status. Stderr:" >&2
  sed -n '1,200p' "$solution_err" >&2
  echo "--- Full stdout ---"
  sed -n '1,200p' "$solution_out"
fi

echo
echo "--- Student stdout ---"
sed -n '1,200p' "$student_out"
echo "--- Solution stdout ---"
sed -n '1,200p' "$solution_out"

if diff -u "$solution_out" "$student_out"; then
  echo
  echo "Outputs match — well done!"
  rm -rf "$TMPDIR"
  exit 0
else
  echo
  echo "Outputs differ — see diff above." >&2
  echo "Student stderr (if any):" >&2
  sed -n '1,200p' "$student_err" >&2
  echo "Solution stderr (if any):" >&2
  sed -n '1,200p' "$solution_err" >&2
  echo "Temporary files left in: $TMPDIR" >&2
  exit 7
fi
